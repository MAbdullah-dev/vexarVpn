"f9d165d51b7b44b482bff1e036bd69ea\",\"sourceScreen\":\"projects/9118612507450158492/screens/f9d165d51b7b44b482bff1e036bd69ea\",\"x\":1024,\"width\":390,\"height\":1142,\"label\":\"Home — VPN Connected Hub\"},{\"id\":\"fa7f8c6fa0254e4385c7b151e9ee8566\",\"sourceScreen\":\"projects/9118612507450158492/screens/fa7f8c6fa0254e4385c7b151e9ee8566\",\"y\":33585,\"width\":390,\"height\":1542,\"label\":\"M01 — Panic Button & Emergency Kill Hub\"},{\"id\":\"fb6b40a8db0e49368f5eff817b121fa7\",\"sourceScreen\":\"projects/9118612507450158492/screens/fb6b40a8db0e49368f5eff817b121fa7\",\"x\":908,\"y\":48453,\"width\":390,\"height\":1836,\"label\":\"S04 — Triage War Room & Forensic Incident Dossier\"},{\"id\":\"fc7e2cd206994901a00cb45c2fe97dec\",\"sourceScreen\":\"projects/9118612507450158492/screens/fc7e2cd206994901a00cb45c2fe97dec\",\"x\":1362,\"y\":9532,\"width\":390,\"height\":1276,\"label\":\"B14 — Kill Switch Active\"},{\"id\":\"fdb1fb23335f49d1a35a80571ed2acc3\",\"sourceScreen\":\"projects/9118612507450158492/screens/fdb1fb23335f49d1a35a80571ed2acc3\",\"x\":1816,\"y\":13814,\"width\":390,\"height\":1529,\"label\":\"D05 — DNS, IPv6 & WebRTC Leak Auditor\"},{\"id\":\"ffd7ae3092d94aba9fdf56a8a09ba526\",\"sourceScreen\":\"projects/9118612507450158492/screens/ffd7ae3092d94aba9fdf56a8a09ba526\",\"x\":908,\"y\":6147,\"width\":390,\"height\":996,\"label\":\"A13 — First Connection Successful\"}],\"metadata\":{\"userRole\":\"OWNER\",\"isRemixed\":true}}","type":"text"}],"structuredContent":{"createTime":"2026-11-06T20:59:30.113717Z","designTheme":{"bodyFont":"PLUS_JAKARTA_SANS","bodyFontFamily":"Plus Jakarta Sans","colorMode":"DARK","colorVariant":"FIDELITY","customColor":"#66d5ff","designMd":"---\nname: Aura Kinetic Security\ncolors:\n  surface: '#0b1326'\n  surface-dim: '#0b1326'\n  surface-bright: '#31394d'\n  surface-container-lowest: '#060e20'\n  surface-container-low: '#131b2e'\n  surface-container: '#171f33'\n  surface-container-high: '#222a3d'\n  surface-container-highest: '#2d3449'\n  on-surface: '#dae2fd'\n  on-surface-variant: '#bdc8ce'\n  inverse-surface: '#dae2fd'\n  inverse-on-surface: '#283044'\n  outline: '#879298'\n  outline-variant: '#3e484e'\n  surface-tint: '#64d3fd'\n  primary: '#bfebff'\n  on-primary: '#003545'\n  primary-container: '#66d5ff'\n  on-primary-container: '#005b74'\n  inverse-primary: '#006782'\n  secondary: '#95cfe9'\n  on-secondary: '#003545'\n  secondary-container: '#004d63'\n  on-secondary-container: '#84bdd7'\n  tertiary: '#bdebff'\n  on-tertiary: '#003544'\n  tertiary-container: '#a0cfe3'\n  on-tertiary-container: '#29596b'\n  error: '#ffb4ab'\n  on-error: '#690005'\n  error-container: '#93000a'\n  on-error-container: '#ffdad6'\n  primary-fixed: '#bbe9ff'\n  primary-fixed-dim: '#64d3fd'\n  on-primary-fixed: '#001f29'\n  on-primary-fixed-variant: '#004d63'\n  secondary-fixed: '#bce9ff'\n  secondary-fixed-dim: '#95cfe9'\n  on-secondary-fixed: '#001f29'\n  on-secondary-fixed-variant: '#004d63'\n  tertiary-fixed: '#baeaff'\n  tertiary-fixed-dim: '#9ecee2'\n  on-tertiary-fixed: '#001f29'\n  on-tertiary-fixed-variant: '#194c5e'\n  background: '#0b1326'\n  on-background: '#dae2fd'\n  surface-variant: '#2d3449'\ntypography:\n  display-lg:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 57px\n    fontWeight: '700'\n    lineHeight: 64px\n    letterSpacing: -0.25px\n  display-lg-mobile:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 44px\n    fontWeight: '700'\n    lineHeight: 52px\n    letterSpacing: -0.2px\n  headline-lg:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 32px\n    fontWeight: '600'\n    lineHeight: 40px\n    letterSpacing: 0px\n  headline-md:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 28px\n    fontWeight: '600'\n    lineHeight: 36px\n    letterSpacing: 0px\n  headline-sm:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 24px\n    fontWeight: '600'\n    lineHeight: 32px\n    letterSpacing: 0px\n  title-lg:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 22px\n    fontWeight: '500'\n    lineHeight: 28px\n    letterSpacing: 0px\n  title-md:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 16px\n    fontWeight: '600'\n    lineHeight: 24px\n    letterSpacing: 0.15px\n  title-sm:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 14px\n    fontWeight: '600'\n    lineHeight: 20px\n    letterSpacing: 0.1px\n  body-lg:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 16px\n    fontWeight: '400'\n    lineHeight: 24px\n    letterSpacing: 0.5px\n  body-md:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 14px\n    fontWeight: '400'\n    lineHeight: 20px\n    letterSpacing: 0.25px\n  body-sm:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 12px\n    fontWeight: '400'\n    lineHeight: 16px\n    letterSpacing: 0.4px\n  label-lg:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 14px\n    fontWeight: '600'\n    lineHeight: 20px\n    letterSpacing: 0.1px\n  label-md:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 12px\n    fontWeight: '600'\n    lineHeight: 16px\n    letterSpacing: 0.5px\n  label-sm:\n    fontFamily: Plus Jakarta Sans\n    fontSize: 11px\n    fontWeight: '500'\n    lineHeight: 16px\n    letterSpacing: 0.5px\nrounded:\n  sm: 0.5rem\n  DEFAULT: 1rem\n  md: 1.5rem\n  lg: 2rem\n  xl: 3rem\n  full: 9999px\nspacing:\n  gutter: 1rem\n  margin: 1rem\n  gutter-tablet: 1.5rem\n  margin-tablet: 2rem\n  space-xs: 0.25rem\n  space-sm: 0.5rem\n  space-md: 1rem\n  space-lg: 1.5rem\n  space-xl: 2rem\n---\n\n## Brand & Style\n\nThis design system translates next-generation mobile cybersecurity into an experience defined by calm confidence, intelligent protection, and fluid connectivity. Rather than relying on defensive alarmism or sterile utility, the interface projects an ambient shield: high-trust, unobtrusive during steady-state protection, yet dynamically expressive during transitions, threats, and state changes.\n\nRooted in an evolution of Material Design 3 Expressive, the aesthetic pairs disciplined, ergonomic Android architecture with luminous ambient indicators. Visual states leverage soft glowing halos, adaptive tonal surface containers, and organic pill-shaped touch surfaces. The interaction tone balances surgical privacy engineering with approachable simplicity for mobile-first workflows.\n\n## Colors\n\nThe system operates with `dark` as its primary default state, mirroring privacy-focused Android flagship applications and reducing OLED display power consumption during persistent background usage. \n\n### Dark Theme (Default)\n- **Primary:** `#66D5FF` — Luminous cyber cyan/teal used for active protection indicators, primary FABs, and connected state signals.\n- **On Primary:** `#003545` — Deep slate-teal providing high-contrast readability against glowing cyan controls.\n- **Primary Container:** `#004D63` — Mid-tone cyan container applied to active server rows and selected segmented chips.\n- **On Primary Container:** `#BAEAFF` — High-luminance accent tint for labels inside primary containers.\n- **Surface:** `#0F172A` — Deep slate midnight canvas baseline.\n- **Surface Container Low:** `#1E293B` — Resting cards, server list items, and metric groupings.\n- **Surface Container High:** `#334155` — Elevated dialogs, active bottom sheets, and pressed states.\n- **Outline:** `#8A9296` — Subtle boundary delineator calibrated for dark contrast compliance.\n- **Error:** `#FFB4AB` — High-alert crimson tint for connection drops, kill switch triggers, and DNS leaks.\n\n### Light Theme\n- **Primary:** `#006783` — Deep cyan for commanding actions, active toggles, and brand anchors.\n- **On Primary:** `#FFFFFF` — Crisp optical white.\n- **Primary Container:** `#BAEAFF` — Ice cyan background for activated utility blocks.\n- **On Primary Container:** `#001F28` — Deepest midnight-teal text.\n- **Surface:** `#F8FAFC` — Pure crisp backdrop.\n- **Surface Container Low:** `#F1F5F9` — Primary grouping cards.\n- **Surface Container High:** `#E2E8F0` — Modals, toolbars, and search bars.\n- **Outline:** `#70787D` — Structural border definition.\n- **Error:** `#BA1A1A` — High-visibility alert red.\n\nState layers apply an opacity overlay of the corresponding `on-*` color: Hover (8%), Focus (12%), Pressed (16%), and Dragged (20%).\n\n## Typography\n\nThe type system relies on `Plus Jakarta Sans` across all display, body, and label roles, using Android's system font as an immediate fallback. Its clean geometric curves and open counter forms ensure legibility at micro scales during status reporting (e.g., kilobits-per-second counters, IP addresses, latency graphs) while delivering a refined, modern tech presence on large display screens.\n\nNumbers in data counters, telemetry readouts, and throughput monitors must always enforce tabular figures (`font-variant-numeric: tabular-nums`) to prevent layout shifts during live ping and bandwidth fluctuations.\n\n## Layout & Spacing\n\nLayout geometry follows an 8dp structural grid, underpinned by a 4dp micro-grid for compact internal component spacing, badges, and icon pairings. All clickable targets strictly enforce a minimum touch target size of 48×48dp regardless of visual container boundary.\n\n- **Compact (Mobile: < 600dp):** Fluid single-column layout with 16dp (`margin`) screen edges and 16dp (`gutter`) card separation. Navigation utilizes an ergonomic bottom bar or expandable bottom sheet.\n- **Medium (Tablet / Foldable unfolded: 600dp–839dp):** Dual-pane structure with 24dp screen padding and 32dp gutter. The primary pane houses connection controls and live status visualizations; the secondary pane houses server node directories and split-tunneling settings.\n- **Expanded (Landscape / Large Screens: 840dp+):** Rail-based navigation with max-width content bounding containers set to 1040dp to prevent unwieldy scan lines on wide displays.\n\n## Elevation & Depth\n\nVisual hierarchy does not use sharp drop-shadows. Instead, elevation is achieved through a combination of M3 tonal layering, luminous halos, and low-contrast ghost outlines:\n\n1. **Surface Hierarchy (Tonal Stepping):** Depth is communicated through luminance progression. Base canvas rests on `Surface` (`#0F172A`). Resting cards sit on `Surface Container Low` (`#1E293B`). Lifted sheets, modals, and tooltips occupy `Surface Container High` (`#334155`).\n2. **Halo Radiation (Active States):** The central connection node and active status chips project a dual-layer soft ambient glow rather than a standard shadow:\n   - Primary Halo: `0 0 32px 0 rgba(102, 213, 255, 0.25)`\n   - Intense Core Glow: `0 0 12px 2px rgba(102, 213, 255, 0.40)`\n3. **Ghost Outlines:** Elevated surfaces are framed by a 1px border of `Outline` at 18% opacity, ensuring sharp separation between tonal tiers without heavy visual weight.\n4. **Modal Elevation:** Full-screen dialogs and modal bottom sheets utilize a scrim overlay with a dynamic backdrop blur (`backdrop-filter: blur(16px)` with 60% opacity surface tint).\n\n## Shapes\n\nThe design system embraces an expressive corner philosophy, utilizing full pills for interaction touchpoints and soft rounded squircular forms for data containers:\n\n- **Full Pill (`9999px`):** Reserved for primary calls to action, the main connect toggle button, search input containers, chips, and navigation indicator pills.\n- **Containers & Cards (`2rem` / 32px):** Applied to major dashboard panels, protocol configuration cards, and speed test containers.\n- **Internal Nested Elements (`1rem` / 16px):** Used for nested sub-cards, server items within a grouped section, and secondary inputs.\n- **Small Controls (`0.5rem` / 8px):** Checkboxes, status badges, and technical readouts.\n\n## Components\n\n### Hero Connect Button (Central Action)\n- **Geometry:** Large 96dp circle (idle) or pill form, centered within a multi-ringed 160dp canvas.\n- **Resting (Disconnected):** Outlined border (2dp) in `Outline` over `Surface Container Low`, containing a neutral power icon.\n- **Active (Connected):** Filled container in `Primary` with `On Primary` icon. Enclosed by two pulsating concentric halo rings animating subtly between 12dp and 24dp scale with 20% opacity.\n- **Connecting:** Continuous smooth angular sweep gradient rotating along the perimeter with a 4dp stroke.\n\n### Buttons\n- **Primary:** Full pill (48dp height), background `Primary`, text `On Primary` (`label-lg`). Minimum width 120dp.\n- **Tonal (Secondary):** Full pill (40dp height), background `Primary Container`, text `On Primary Container`.\n- **Outlined:** 40dp pill, 1px border in `Outline` at 30% opacity, transparent background, text `Primary`.\n- **Touch Target:** Internal padding at least 12dp horizontal, centered within 48dp absolute bounding box.\n\n### Chips (Protocol & Server Filters)\n- **Height:** 32dp pill.\n- **Unselected:** `Surface Container Low` with 1px border in `Outline` at 20% opacity. Text in `body-sm`.\n- **Selected:** `Primary Container` with `On Primary Container` text, accompanied by a 16dp checkmark or active icon leading the label.\n\n### Server List Items\n- **Structure:** 64dp vertical height card or continuous list item on `Surface Container Low`.\n- **Content:** Left-aligned 28dp circular country flag avatar, followed by Server Name (`title-sm`) and City/IP (`body-sm`). Trailing block houses latency ping (color-coded badge: green `<50ms`, yellow `50–120ms`, red `>120ms`) and a favorite toggle.\n- **Active Selection:** Bordered by a 1.5dp stroke of `Primary` with a soft 6% `Primary` surface tint.\n\n### Input Fields & Search Bars\n- **Search Bar:** 48dp full pill, background `Surface Container High`, icon leading, clear action trailing. No border in resting state; 2dp `Primary` outline on focus.\n- **Standard Text Fields:** 56dp height, rounded 16dp top and bottom corners, floating label architecture conforming to M3 specs. Background `Surface Container Low`.\n\n### Checkboxes, Radios, and Toggles\n- **Switches (Kill Switch, Auto-Connect):** 32dp tall, 52dp wide pill track. Unchecked: track `Surface Container High`, thumb `Outline`. Checked: track `Primary`, thumb `On Primary` (thumb expands slightly on press).\n- **Checkboxes:** 20×20dp box with 6dp corner radius. Checked fill `Primary` with `On Primary` check mark.\n\n### Telemetry / Traffic Cards\n- **Geometry:** 24dp rounded rectangles using `Surface Container Low`.\n- **Display:** Split-pane layout displaying Download/Upload live throughput with stylized sparklines drawn with a 2dp stroke in `Primary` and secondary muted teal. All numerical metrics use tabular figures (`title-lg`).","font":"PLUS_JAKARTA_SANS","headlineFont":"PLUS_JAKARTA_SANS","headlineFontFamily":"Plus Jakarta Sans","labelFont":"PLUS_JAKARTA_SANS","labelFontFamily":"Plus Jakarta Sans","namedColors":{"background":"#0b1326","error":"#ffb4ab","error_container":"#93000a","inverse_on_surface":"#283044","inverse_primary":"#006782","inverse_surface":"#dae2fd","on_background":"#dae2fd","on_error":"#690005","on_error_container":"#ffdad6","on_primary":"#003545","on_primary_container":"#005b74","on_primary_fixed":"#001f29","on_primary_fixed_variant":"#004d63","on_secondary":"#003545","on_secondary_container":"#84bdd7","on_secondary_fixed":"#001f29","on_secondary_fixed_variant":"#004d63","on_surface":"#dae2fd","on_surface_variant":"#bdc8ce","on_tertiary":"#003544","on_tertiary_container":"#29596b","on_tertiary_fixed":"#001f29","on_tertiary_fixed_variant":"#194c5e","outline":"#879298","outline_variant":"#3e484e","primary":"#bfebff","primary_container":"#66d5ff","primary_fixed":"#bbe9ff","primary_fixed_dim":"#64d3fd","secondary":"#95cfe9","secondary_container":"#004d63","secondary_fixed":"#bce9ff","secondary_fixed_dim":"#95cfe9","surface":"#0b1326","surface_bright":"#31394d","surface_container":"#171f33","surface_container_high":"#222a3d","surface_container_highest":"#2d3449","surface_container_low":"#131b2e","surface_container_lowest":"#060e20","surface_dim":"#0b1326","surface_tint":"#64d3fd","surface_variant":"#2d3449","tertiary":"#bdebff","tertiary_container":"#a0cfe3","tertiary_fixed":"#baeaff","tertiary_fixed_dim":"#9ecee2"},"overrideNeutralColor":"#0f172a","overridePrimaryColor":"#66d5ff","overrideSecondaryColor":"#004d63","overrideTertiaryColor":"#baeaff","roundness":"ROUND_FULL","spacing":{"gutter":"1rem","gutter-tablet":"1.5rem","margin":"1rem","margin-tablet":"2rem","space-lg":"1.5rem","space-md":"1rem","space-sm":"0.5rem","space-xl":"2rem","space-xs":"0.25rem"},"typography":{"body-lg":{"fontFamily":"Plus Jakarta Sans","fontSize":"16px","fontWeight":"400","letterSpacing":"0.5px","lineHeight":"24px"},"body-md":{"fontFamily":"Plus Jakarta Sans","fontSize":"14px","fontWeight":"400","letterSpacing":"0.25px","lineHeight":"20px"},"body-sm":{"fontFamily":"Plus Jakarta Sans","fontSize":"12px","fontWeight":"400","letterSpacing":"0.4px","lineHeight":"16px"},"display-lg":{"fontFamily":"Plus Jakarta Sans","fontSize":"57px","fontWeight":"700","letterSpacing":"-0.25px","lineHeight":"64px"},"display-lg-mobile":{"fontFamily":"Plus Jakarta Sans","fontSize":"44px","fontWeight":"700","letterSpacing":"-0.2px","lineHeight":"52px"},"headline-lg":{"fontFamily":"Plus Jakarta Sans","fontSize":"32px","fontWeight":"600","letterSpacing":"0px","lineHeight":"40px"},"headline-md":{"fontFamily":"Plus Jakarta Sans","fontSize":"28px","fontWeight":"600","letterSpacing":"0px","lineHeight":"36px"},"headline-sm":{"fontFamily":"Plus Jakarta Sans","fontSize":"24px","fontWeight":"600","letterSpacing":"0px","lineHeight":"32px"},"label-lg":{"fontFamily":"Plus Jakarta Sans","fontSize":"14px","fontWeight":"600","letterSpacing":"0.1px","lineHeight":"20px"},"label-md":{"fontFamily":"Plus Jakarta Sans","fontSize":"12px","fontWeight":"600","letterSpacing":"0.5px","lineHeight":"16px"},"label-sm":{"fontFamily":"Plus Jakarta Sans","fontSize":"11px","fontWeight":"500","letterSpacing":"0.5px","lineHeight":"16px"},"title-lg":{"fontFamily":"Plus Jakarta Sans","fontSize":"22px","fontWeight":"500","letterSpacing":"0px","lineHeight":"28px"},"title-md":{"fontFamily":"Plus Jakarta Sa