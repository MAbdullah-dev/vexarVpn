ight":1380,"id":"259a56caa74c48b1ac3a295007275c39","label":"C05 — Server Deep Telemetry & Node Inspection","sourceScreen":"projects/9118612507450158492/screens/259a56caa74c48b1ac3a295007275c39","width":390,"x":1362,"y":11349},{"height":1544,"id":"263d02bd73c5473aa883ce1ece45da16","label":"F04 — Purchase Success & Cryptographic License Activation","sourceScreen":"projects/9118612507450158492/screens/263d02bd73c5473aa883ce1ece45da16","width":390,"x":1362,"y":18021},{"height":1786,"id":"2700c310eb57445887dd5721d9809bae","label":"M03 — Duress PIN & Decoy Environment Setup","sourceScreen":"projects/9118612507450158492/screens/2700c310eb57445887dd5721d9809bae","width":390,"x":908,"y":33585},{"height":1440,"id":"28e7a6b230d7448c9d6663997527dbb9","label":"H04 — Heads-Up Security Alerts & Fail-Safe Popups","sourceScreen":"projects/9118612507450158492/screens/28e7a6b230d7448c9d6663997527dbb9","width":390,"x":1362,"y":22206},{"height":1489,"id":"2bf09371a77646ca9fa15aa449f04374","label":"B07 — Home Connection Error","sourceScreen":"projects/9118612507450158492/screens/2bf09371a77646ca9fa15aa449f04374","width":390,"x":1362,"y":7752},{"height":776,"id":"2e253002-83b2-474c-95e9-3d9a3621be6d","label":"image.png","sourceScreen":"projects/9118612507450158492/screens/15365755649829389144","type":"SCREEN_INSTANCE","width":512,"y":2455},{"height":1349,"id":"31acdd8f6c0d4b4e8ea0c4f303223b3e","label":"A14 — First Connection Failed / Retry","sourceScreen":"projects/9118612507450158492/screens/31acdd8f6c0d4b4e8ea0c4f303223b3e","width":390,"y":6147},{"height":1826,"id":"3358b310f9264e1cb4f3e2cdab245f24","label":"E04 — Kill Switch & Fail-Safe Hardening","sourceScreen":"projects/9118612507450158492/screens/3358b310f9264e1cb4f3e2cdab245f24","width":390,"x":1362,"y":15808},{"height":1208,"id":"348e98db4a534b998116e59171e7fc14","label":"G03 — Live Query Intercept Log & Inspection","sourceScreen":"projects/9118612507450158492/screens/348e98db4a534b998116e59171e7fc14","width":390,"x":1362,"y":2000